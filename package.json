{
  "name": "svg-editor-cli-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Advanced Software Development lab: an object-oriented SVG CLI editor",
  "type": "module",
  "engines": {
    "node": ">=22.15.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "cli": "tsx src/bootstrap/main.ts",
